# Settings for the Azure scripts in this folder. Not secret: safe to commit.
# The subscription ID is passed on the command line, not stored here.

# Resource group that holds the website.
RESOURCE_GROUP="rg-5spice-web"

# Region for the Static Web App resource. The site itself is served from
# Azure's global network; this only sets where the resource's metadata lives.
# Allowed: westus2, centralus, eastus2, westeurope, eastasia.
LOCATION="centralus"

# Static Web App name (unique within the resource group).
APP_NAME="swa-5spice-web"

# Plan: Free now. Change to Standard later with:
#   ./infra/setup-azure.sh --subscription <id> --sku Standard
SKU="Free"

# GitHub repository that deploys to it.
GITHUB_REPO="masudevops/5spice"

# Tags added to every resource (helps with cost tracking).
TAGS="project=5spice app=website"
