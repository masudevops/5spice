# Copy to .env for local development. In production (Azure Static Web Apps),
# VITE_APP_SITE_MODE comes from the GitHub repository variable of the same name
# (see DEPLOYMENT.md).

# Which version of the site to render:
#   coming_soon – landing page only (no nav/footer)
#   live        – full site (default if unset or any other value)
VITE_APP_SITE_MODE=live

# Cloudflare Web Analytics token (public, not a secret). Leave empty locally.
# In production it comes from the GitHub repository variable of the same name.
# The script only loads on 5spicemarket.com, never on localhost or previews.
VITE_CF_ANALYTICS_TOKEN=
