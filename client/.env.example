# Copy to .env for local development. On Vercel, set these in
# Project Settings → Environment Variables (they override this file).

# Which version of the site to render:
#   coming_soon – landing page only (no nav/footer)
#   live        – full site (default if unset or any other value)
VITE_APP_SITE_MODE=live

# VITE_ON_VERCEL is not set here: client/vite.config.js sets it automatically
# (true only on Vercel builds) to decide whether to load Vercel Web Analytics.
#
# On Azure Static Web Apps, VITE_APP_SITE_MODE comes from the GitHub repository
# variable of the same name (see infra/README.md).
